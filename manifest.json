{
  "manifest_version": 3,
  "name": "ChatGPT RTL Fix",
  "version": "3.3.0",
  "description": "Fixes Persian/English RTL and LTR rendering on ChatGPT, including mixed paragraphs, lists, tables, code blocks, and writing blocks.",
  "author": "Amin",
  "icons": {
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-rtl-fix@amin.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
